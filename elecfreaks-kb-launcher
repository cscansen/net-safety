#!/usr/bin/env bash
# Open ElecFreaks KB — online if reachable, local mirror otherwise.
# Transparent to the kid: one icon, always works.

ONLINE="https://wiki.elecfreaks.com/en/microbit/"
OFFLINE="http://localhost:8080/en/microbit/"

if curl --max-time 3 --connect-timeout 3 -sf "$ONLINE" >/dev/null 2>&1; then
    xdg-open "$ONLINE"
else
    xdg-open "$OFFLINE"
fi
